generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

enum AttemptStatus {
  STARTED
  SUCCEEDED
  FAILED
  UNKNOWN
}

enum ReceiverMode {
  SUCCEED
  FAIL_TWICE
  ALWAYS_FAIL
  TIMEOUT
}

model Workspace {
  id               String     @id @default(uuid()) @db.Uuid
  name             String
  slug             String?    @unique @db.VarChar(60)
  credentialDigest String?    @db.Char(64)
  endpoint         Endpoint?
  events           Event[]
  apiKeys          ApiKey[]
}

model Endpoint {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @unique @db.Uuid
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name        String
  destinationUrl String?  @db.VarChar(2048)
  events      Event[]
  deliveries  Delivery[]
}

model Event {
  id                 String     @id @default(uuid()) @db.Uuid
  workspaceId        String     @db.Uuid
  workspace          Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  endpointId         String     @db.Uuid
  endpoint           Endpoint   @relation(fields: [endpointId], references: [id], onDelete: Restrict)
  eventType          String     @db.VarChar(80)
  payload            Json
  canonicalBody      String
  requestFingerprint String     @db.Char(64)
  idempotencyKey     String     @db.VarChar(128)
  isTest             Boolean    @default(false)
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  deliveries         Delivery[]

  @@unique([workspaceId, idempotencyKey])
}

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name        String    @db.VarChar(80)
  prefix      String    @db.VarChar(16)
  digest      String    @unique @db.Char(64)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)

  @@index([workspaceId, createdAt])
}

model Delivery {
  id                   String            @id @default(uuid()) @db.Uuid
  eventId              String            @db.Uuid
  event                Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  endpointId           String            @db.Uuid
  endpoint             Endpoint          @relation(fields: [endpointId], references: [id], onDelete: Restrict)
  status               DeliveryStatus    @default(PENDING)
  cycle                Int               @default(1)
  attemptsInCycle      Int               @default(0)
  nextAttemptAt        DateTime?         @default(dbgenerated("date_trunc('milliseconds'::text, CURRENT_TIMESTAMP)")) @db.Timestamptz(3)
  leaseToken           String?           @db.Uuid
  leaseExpiresAt       DateTime?         @db.Timestamptz(3)
  receiverMode         ReceiverMode
  historical           Boolean           @default(false)
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(3)
  attempts             DeliveryAttempt[]

  @@unique([eventId, endpointId])
  @@index([status, nextAttemptAt, id])
  @@index([status, leaseExpiresAt])
  @@index([createdAt, id])
}

model DeliveryAttempt {
  id            String        @id @default(uuid()) @db.Uuid
  deliveryId    String        @db.Uuid
  delivery      Delivery      @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  cycle         Int
  attemptNumber Int
  leaseToken    String        @db.Uuid
  receiverMode  ReceiverMode
  status        AttemptStatus @default(STARTED)
  startedAt     DateTime      @default(now()) @db.Timestamptz(3)
  completedAt   DateTime?     @db.Timestamptz(3)
  httpStatus    Int?
  durationMs    Int?
  error         String?       @db.VarChar(160)

  @@unique([deliveryId, cycle, attemptNumber])
  @@index([completedAt])
}
