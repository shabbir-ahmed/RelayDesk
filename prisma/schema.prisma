generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

enum AttemptStatus {
  STARTED
  SUCCEEDED
  FAILED
  UNKNOWN
}

enum ReceiverMode {
  SUCCEED
  FAIL_TWICE
  ALWAYS_FAIL
  TIMEOUT
}

enum AuditAction {
  WORKSPACE_CREATED
  DESTINATION_APPROVED
  SUBSCRIPTIONS_UPDATED
  DELIVERY_REPLAYED
  API_KEY_CREATED
  API_KEY_REVOKED
  INVITE_CREATED
  INVITE_ACCEPTED
  INVITE_REVOKED
  MEMBER_REMOVED
  API_KEY_ROTATED
  SIGNING_KEY_ROTATED
  DESTINATION_REQUESTED
  DESTINATION_REQUEST_REJECTED
}

enum Environment {
  TEST
  LIVE
}

enum DestinationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

model Workspace {
  id               String     @id @default(uuid()) @db.Uuid
  name             String
  slug             String?    @unique @db.VarChar(60)
  credentialDigest String?    @db.Char(64)
  endpoints        Endpoint[]
  destinationRequests DestinationRequest[]
  events           Event[]
  apiKeys          ApiKey[]
  auditEntries     AuditEntry[]
  memberships      Membership[]
  invitations      Invitation[]
  dailyUsage       DailyUsage[]
}

model Account {
  id             String       @id @default(uuid()) @db.Uuid
  username       String       @unique @db.VarChar(60)
  passwordHash   String       @db.VarChar(160)
  sessionVersion Int          @default(0)
  recoveryDigest String?      @db.Char(64)
  memberships    Membership[]
}

model Membership {
  workspaceId String        @db.Uuid
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  accountId   String        @db.Uuid
  account     Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  sessionId   String        @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)

  @@id([workspaceId, accountId])
  @@index([accountId])
}

model Invitation {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  digest      String    @unique @db.Char(64)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime  @db.Timestamptz(3)
  redeemedAt  DateTime? @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)

  @@index([workspaceId, createdAt, id])
}

model DailyUsage {
  workspaceId String      @db.Uuid
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  environment Environment
  day         DateTime    @db.Date
  count       Int
  deliveries  Int         @default(0)

  @@id([workspaceId, environment, day])
}

model Endpoint {
  id                  String      @id @default(uuid()) @db.Uuid
  workspaceId         String      @db.Uuid
  workspace           Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name                String
  destinationUrl      String?     @db.VarChar(2048)
  environment         Environment @default(LIVE)
  eventTypes          String[]    @default([])
  signingVersion      Int         @default(1)
  signingOverlapUntil DateTime?   @db.Timestamptz(3)
  deliveries          Delivery[]
  requests            DestinationRequest[]

  @@unique([workspaceId, environment, destinationUrl])
}

model DestinationRequest {
  id             String                   @id @default(uuid()) @db.Uuid
  workspaceId    String                   @db.Uuid
  workspace      Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  environment    Environment
  name           String                   @db.VarChar(80)
  destinationUrl String                   @db.VarChar(2048)
  status         DestinationRequestStatus @default(PENDING)
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)
  reviewedAt     DateTime?                @db.Timestamptz(3)
  reviewNote     String?                  @db.VarChar(240)
  endpointId     String?                  @db.Uuid
  endpoint       Endpoint?                @relation(fields: [endpointId], references: [id], onDelete: Restrict)

  @@index([workspaceId, environment, destinationUrl, status], map: "DestinationRequest_lookup_idx")
  @@index([workspaceId, environment, createdAt, id])
  @@index([status, createdAt, id])
  @@index([endpointId])
}

model Event {
  id                 String      @id @default(uuid()) @db.Uuid
  workspaceId        String      @db.Uuid
  workspace          Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  eventType          String      @db.VarChar(80)
  environment        Environment @default(LIVE)
  payload            Json
  canonicalBody      String
  payloadPurgedAt    DateTime?   @db.Timestamptz(3)
  requestFingerprint String      @db.Char(64)
  idempotencyKey     String      @db.VarChar(128)
  isTest             Boolean     @default(false)
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  deliveries         Delivery[]

  @@unique([workspaceId, environment, idempotencyKey])
  @@index([payloadPurgedAt, createdAt])
}

model ApiKey {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name        String      @db.VarChar(80)
  environment Environment @default(LIVE)
  prefix      String      @db.VarChar(16)
  digest      String      @unique @db.Char(64)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  revokedAt   DateTime?   @db.Timestamptz(3)
  expiresAt   DateTime?   @db.Timestamptz(3)

  @@index([workspaceId, environment, createdAt])
}

model Delivery {
  id              String            @id @default(uuid()) @db.Uuid
  eventId         String            @db.Uuid
  event           Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  endpointId      String            @db.Uuid
  endpoint        Endpoint          @relation(fields: [endpointId], references: [id], onDelete: Restrict)
  status          DeliveryStatus    @default(PENDING)
  cycle           Int               @default(1)
  attemptsInCycle Int               @default(0)
  nextAttemptAt   DateTime?         @default(dbgenerated("date_trunc('milliseconds'::text, CURRENT_TIMESTAMP)")) @db.Timestamptz(3)
  leaseToken      String?           @db.Uuid
  leaseExpiresAt  DateTime?         @db.Timestamptz(3)
  receiverMode    ReceiverMode
  historical      Boolean           @default(false)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  attempts        DeliveryAttempt[]
  alerts          FailureAlert[]

  @@unique([eventId, endpointId])
  @@index([status, nextAttemptAt, id])
  @@index([endpointId, status])
  @@index([status, leaseExpiresAt])
  @@index([createdAt, id])
}

model FailureAlert {
  id             String    @id @default(uuid()) @db.Uuid
  deliveryId     String    @db.Uuid
  delivery       Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  cycle          Int
  reason         String    @db.VarChar(160)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  acknowledgedAt DateTime? @db.Timestamptz(3)

  @@unique([deliveryId, cycle])
  @@index([acknowledgedAt, createdAt, id])
  @@index([createdAt])
}

model AuditEntry {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  action      AuditAction
  environment Environment?
  actor       String?     @db.VarChar(80)
  targetId    String      @db.Uuid
  summary     String      @db.VarChar(240)
  eventTypes  String[]    @default([])
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)

  @@index([workspaceId, createdAt, id])
}

model DeliveryAttempt {
  id            String        @id @default(uuid()) @db.Uuid
  deliveryId    String        @db.Uuid
  delivery      Delivery      @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  cycle         Int
  attemptNumber Int
  leaseToken    String        @db.Uuid
  receiverMode  ReceiverMode
  status        AttemptStatus @default(STARTED)
  startedAt     DateTime      @default(now()) @db.Timestamptz(3)
  completedAt   DateTime?     @db.Timestamptz(3)
  httpStatus    Int?
  durationMs    Int?
  error         String?       @db.VarChar(160)

  @@unique([deliveryId, cycle, attemptNumber])
  @@index([completedAt])
}

model AuthLimit {
  key         String   @id
  windowStart DateTime @db.Timestamptz(3)
  count       Int
}

model WorkerHeartbeat {
  mode   String   @id
  seenAt DateTime @db.Timestamptz(3)
}
