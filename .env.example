# Local PostgreSQL defaults match compose.yaml. Use a dedicated database and role in hosting.
DATABASE_URL=postgresql://relaydesk:relaydesk@127.0.0.1:5432/relaydesk?connection_limit=4
# Separate, disposable database for npm run verify.
TEST_DATABASE_URL=postgresql://relaydesk:relaydesk@127.0.0.1:5432/relaydesk_test?connection_limit=4
# Set the public web origin exactly, including its scheme and any non-default port.
APP_ORIGIN=http://localhost:3000
RELAYDESK_MODE=private
# Generate each private-instance key separately with openssl rand -hex 32.
SESSION_SECRET=
DESTINATION_SIGNING_KEY=
# Optional bearer token for the private operations metrics collector.
OPS_METRICS_TOKEN=
# These settings apply only to an isolated RELAYDESK_MODE=demo instance.
OPERATOR_CREDENTIAL=local-demo-password
API_TOKEN=replace-with-a-unique-api-token-32-bytes
RECEIVER_SECRET=replace-with-a-unique-receiver-secret-32-bytes
RECEIVER_BASE_URL=http://localhost:3000
