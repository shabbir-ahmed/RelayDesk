{
  "name": "relaydesk",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13 <23"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "next dev --webpack",
    "start": "node --env-file-if-exists=.env .next/standalone/server.js",
    "worker:dev": "node --env-file-if-exists=.env --import tsx src/worker/main.ts",
    "worker": "node --env-file-if-exists=.env dist/src/worker/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "next build --webpack && tsc -p tsconfig.worker.json && node scripts/stage-web.mjs",
    "test:unit": "vitest run tests/unit",
    "test:integration": "node scripts/test-runner.mjs integration",
    "test:e2e": "node scripts/test-runner.mjs e2e",
    "verify": "node scripts/test-runner.mjs verify",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "fast-json-stable-stringify": "2.1.0",
    "jose": "5.10.0",
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.17",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
